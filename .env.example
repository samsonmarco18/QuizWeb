QUIZWEB_DB_HOST=127.0.0.1
QUIZWEB_DB_PORT=5432
QUIZWEB_DB_NAME=quizweb
QUIZWEB_DB_USER=quizweb
QUIZWEB_DB_PASS=replace-with-a-strong-password

# Optional AI quiz drafts. Configure actual server environment variables;
# this application does not automatically load .env files.
GEMINI_API_KEY=
QUIZWEB_GEMINI_MODEL=gemini-3.8-flash
# Optional dedicated base64-encoded 32-byte secret for admin-stored API keys.
QUIZWEB_AI_ENCRYPTION_KEY=
